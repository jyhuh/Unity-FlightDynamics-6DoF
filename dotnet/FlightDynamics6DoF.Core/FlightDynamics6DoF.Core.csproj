<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
    <AssemblyName>FlightDynamics6DoF.Core</AssemblyName>
    <RootNamespace>FlightDynamics6DoF.Core</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>FlightDynamics 6-DOF Engineering</Authors>
    <Description>Engineering-grade Nonlinear 6-DOF Flight Dynamics Model (FDM), Multi-Fidelity Aerodynamic Analysis Suite (CST/NeuralFoil, AirfoilPrep Viterna/Du-Selig, 3D VLM, Slender Body, CCBlade BEMT, Slipstream Wake), GNC Flight Controller, and Zero-Dependency MAVLink v2 / PX4 SITL Engine.</Description>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <Deterministic>true</Deterministic>
    <Optimize Condition="'$(Configuration)' == 'Release'">true</Optimize>
  </PropertyGroup>

</Project>
